{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "string"
    },
    "stock_status": {
      "type": "enumeration",
      "enum": [
        "In Stock",
        "Out of Stock",
        "Low"
      ]
    },
    "machine_models": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::machine-model.machine-model",
      "mappedBy": "compatible_parts"
    },
    "specs": {
      "type": "json"
    },
    "brand": {
      "type": "string",
      "unique": false
    },
    "price": {
      "type": "decimal"
    },
    "condition": {
      "type": "string"
    },
    "sfId": {
      "type": "string"
    },
    "productImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
