generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_permissions {
  id                                                     Int                                       @id @default(autoincrement())
  document_id                                            String?                                   @db.VarChar(255)
  action                                                 String?                                   @db.VarChar(255)
  action_parameters                                      Json?
  subject                                                String?                                   @db.VarChar(255)
  properties                                             Json?
  conditions                                             Json?
  created_at                                             DateTime?                                 @db.Timestamp(6)
  updated_at                                             DateTime?                                 @db.Timestamp(6)
  published_at                                           DateTime?                                 @db.Timestamp(6)
  created_by_id                                          Int?
  updated_by_id                                          Int?
  locale                                                 String?                                   @db.VarChar(255)
  createdBy                                              admin_users?                              @relation("admin_permissions_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "admin_permissions_created_by_id_fk")
  updatedBy                                              admin_users?                              @relation("admin_permissions_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "admin_permissions_updated_by_id_fk")
  admin_permissions_role_lnk                             admin_permissions_role_lnk[]
  strapi_workflows_stages_permissions_lnk                strapi_workflows_stages_permissions_lnk[]

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "admin_permissions_documents_idx")
}

model admin_permissions_role_lnk {
  id                Int                @id @default(autoincrement())
  permission_id     Int?
  role_id           Int?
  permission_ord    Float?
  admin_permissions admin_permissions? @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_permissions_role_lnk_fk")
  admin_roles       admin_roles?       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_permissions_role_lnk_ifk")

  @@unique([permission_id, role_id], map: "admin_permissions_role_lnk_uq")
  @@index([permission_id])
  @@index([role_id])
  @@index([permission_ord], map: "admin_permissions_role_lnk_oifk")
}

model admin_roles {
  id                           Int                            @id @default(autoincrement())
  document_id                  String?                        @db.VarChar(255)
  name                         String?                        @db.VarChar(255)
  code                         String?                        @db.VarChar(255)
  description                  String?                        @db.VarChar(255)
  created_at                   DateTime?                      @db.Timestamp(6)
  updated_at                   DateTime?                      @db.Timestamp(6)
  published_at                 DateTime?                      @db.Timestamp(6)
  created_by_id                Int?
  updated_by_id                Int?
  locale                       String?                        @db.VarChar(255)
  admin_permissions_role_lnk   admin_permissions_role_lnk[]
  createdBy                    admin_users?                   @relation("admin_roles_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "admin_roles_created_by_id_fk")
  updatedBy                    admin_users?                   @relation("admin_roles_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "admin_roles_updated_by_id_fk")
  admin_users_roles_lnk        admin_users_roles_lnk[]

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "admin_roles_documents_idx")
}

model admin_users {
  id                                                     Int                                    @id @default(autoincrement())
  document_id                                            String?                                @db.VarChar(255)
  firstname                                              String?                                @db.VarChar(255)
  lastname                                               String?                                @db.VarChar(255)
  username                                               String?                                @db.VarChar(255)
  email                                                  String?                                @db.VarChar(255)
  password                                               String?                                @db.VarChar(255)
  reset_password_token                                   String?                                @db.VarChar(255)
  registration_token                                     String?                                @db.VarChar(255)
  is_active                                              Boolean?
  blocked                                                Boolean?
  prefered_language                                      String?                                @db.VarChar(255)
  created_at                                             DateTime?                              @db.Timestamp(6)
  updated_at                                             DateTime?                              @db.Timestamp(6)
  published_at                                           DateTime?                              @db.Timestamp(6)
  created_by_id                                          Int?
  updated_by_id                                          Int?
  locale                                                 String?                                @db.VarChar(255)

  // FIX 1: Corrected self-referencing relations
  createdBy                                              admin_users?                           @relation("UserCreations", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "admin_users_created_by_id_fk")
  updatedBy                                              admin_users?                           @relation("UserUpdates", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "admin_users_updated_by_id_fk")
  
  // Back-relations
  created_admin_permissions                              admin_permissions[]                    @relation("admin_permissions_created_by")
  updated_admin_permissions                              admin_permissions[]                    @relation("admin_permissions_updated_by")
  created_admin_roles                                    admin_roles[]                          @relation("admin_roles_created_by")
  updated_admin_roles                                    admin_roles[]                          @relation("admin_roles_updated_by")
  created_users                                          admin_users[]                          @relation("UserCreations")
  updated_users                                          admin_users[]                          @relation("UserUpdates")
  admin_users_roles_lnk                                  admin_users_roles_lnk[]
  created_categories                                     categories[]                           @relation("categories_created_by")
  updated_categories                                     categories[]                           @relation("categories_updated_by")
  created_files                                          files[]                                @relation("files_created_by")
  updated_files                                          files[]                                @relation("files_updated_by")
  created_homepages                                      homepages[]                            @relation("homepages_created_by")
  updated_homepages                                      homepages[]                            @relation("homepages_updated_by")
  created_i18n_locales                                   i18n_locale[]                          @relation("i18n_locales_created_by")
  updated_i18n_locales                                   i18n_locale[]                          @relation("i18n_locales_updated_by")
  created_machine_makes                                  machine_makes[]                        @relation("machine_makes_created_by")
  updated_machine_makes                                  machine_makes[]                        @relation("machine_makes_updated_by")
  created_machine_models                                 machine_models[]                       @relation("machine_models_created_by")
  updated_machine_models                                 machine_models[]                       @relation("machine_models_updated_by")
  created_products                                       products[]                             @relation("products_created_by")
  updated_products                                       products[]                             @relation("products_updated_by")
  created_strapi_api_token_permissions                   strapi_api_token_permissions[]         @relation("strapi_api_token_permissions_created_by")
  updated_strapi_api_token_permissions                   strapi_api_token_permissions[]         @relation("strapi_api_token_permissions_updated_by")
  created_strapi_api_tokens                              strapi_api_tokens[]                    @relation("strapi_api_tokens_created_by")
  updated_strapi_api_tokens                              strapi_api_tokens[]                    @relation("strapi_api_tokens_updated_by")
  strapi_history_versions                                strapi_history_versions[]
  created_strapi_release_actions                         strapi_release_actions[]               @relation("strapi_release_actions_created_by")
  updated_strapi_release_actions                         strapi_release_actions[]               @relation("strapi_release_actions_updated_by")
  created_strapi_releases                                strapi_releases[]                      @relation("strapi_releases_created_by")
  updated_strapi_releases                                strapi_releases[]                      @relation("strapi_releases_updated_by")
  created_strapi_transfer_token_permissions              strapi_transfer_token_permissions[]    @relation("strapi_transfer_token_permissions_created_by")
  updated_strapi_transfer_token_permissions              strapi_transfer_token_permissions[]    @relation("strapi_transfer_token_permissions_updated_by")
  created_strapi_transfer_tokens                         strapi_transfer_tokens[]               @relation("strapi_transfer_tokens_created_by")
  updated_strapi_transfer_tokens                         strapi_transfer_tokens[]               @relation("strapi_transfer_tokens_updated_by")
  created_strapi_workflows                               strapi_workflows[]                     @relation("strapi_workflows_created_by")
  updated_strapi_workflows                               strapi_workflows[]                     @relation("strapi_workflows_updated_by")
  created_strapi_workflows_stages                        strapi_workflows_stages[]              @relation("strapi_workflows_stages_created_by")
  updated_strapi_workflows_stages                        strapi_workflows_stages[]              @relation("strapi_workflows_stages_updated_by")
  created_up_permissions                                 up_permissions[]                       @relation("up_permissions_created_by")
  updated_up_permissions                                 up_permissions[]                       @relation("up_permissions_updated_by")
  created_up_roles                                       up_roles[]                             @relation("up_roles_created_by")
  updated_up_roles                                       up_roles[]                             @relation("up_roles_updated_by")
  created_up_users                                       up_users[]                             @relation("up_users_created_by")
  updated_up_users                                       up_users[]                             @relation("up_users_updated_by")
  created_upload_folders                                 upload_folders[]                       @relation("upload_folders_created_by")
  updated_upload_folders                                 upload_folders[]                       @relation("upload_folders_updated_by")

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "admin_users_documents_idx")
}

model admin_users_roles_lnk {
  id          Int          @id @default(autoincrement())
  user_id     Int?
  role_id     Int?
  role_ord    Float?
  user_ord    Float?
  admin_users admin_users? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_users_roles_lnk_fk")
  admin_roles admin_roles? @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_users_roles_lnk_ifk")

  @@unique([user_id, role_id], map: "admin_users_roles_lnk_uq")
  @@index([user_id])
  @@index([role_id])
  @@index([role_ord], map: "admin_users_roles_lnk_ofk")
  @@index([user_ord], map: "admin_users_roles_lnk_oifk")
}

model cart_items {
  id         Int       @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int       @default(1)
  item_type  item_type @default(BUY_NOW)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @default(now()) @db.Timestamp(6)
  carts      carts     @relation(fields: [cart_id], references: [id], onDelete: Cascade, map: "cart_items_cart_fkey")
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "cart_items_product_fkey")

  @@unique([cart_id, product_id], map: "cart_items_cart_product_key")
}

model carts {
  id         Int          @id @default(autoincrement())
  session_id String       @unique(map: "carts_session_id_idx") @db.VarChar(255)
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @db.Timestamp(6)
  cart_items cart_items[]
}

model categories {
  id                        Int                         @id @default(autoincrement())
  document_id               String?                     @db.VarChar(255)
  name                      String?                     @db.VarChar(255)
  slug                      String?                     @db.VarChar(255)
  created_at                DateTime?                   @db.Timestamp(6)
  updated_at                DateTime?                   @db.Timestamp(6)
  published_at              DateTime?                   @db.Timestamp(6)
  created_by_id             Int?
  updated_by_id             Int?
  locale                    String?                     @db.VarChar(255)
  createdBy                 admin_users?                @relation("categories_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "categories_created_by_id_fk")
  updatedBy                 admin_users?                @relation("categories_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "categories_updated_by_id_fk")
  categories_products_lnk   categories_products_lnk[]

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "categories_documents_idx")
}

model categories_products_lnk {
  id          Int         @id @default(autoincrement())
  category_id Int?
  product_id  Int?
  product_ord Float?
  categories  categories? @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_products_lnk_fk")
  products    products?   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_products_lnk_ifk")

  @@unique([category_id, product_id], map: "categories_products_lnk_uq")
  @@index([category_id])
  @@index([product_id])
  @@index([product_ord], map: "categories_products_lnk_ofk")
}

model files {
  id                  Int                   @id @default(autoincrement())
  document_id         String?               @db.VarChar(255)
  name                String?               @db.VarChar(255)
  alternative_text    String?               @db.VarChar(255)
  caption             String?               @db.VarChar(255)
  width               Int?
  height              Int?
  formats             Json?
  hash                String?               @db.VarChar(255)
  ext                 String?               @db.VarChar(255)
  mime                String?               @db.VarChar(255)
  size                Decimal?              @db.Decimal(10, 2)
  url                 String?               @db.VarChar(255)
  preview_url         String?               @db.VarChar(255)
  provider            String?               @db.VarChar(255)
  provider_metadata   Json?
  folder_path         String?               @db.VarChar(255)
  created_at          DateTime?             @db.Timestamp(6)
  updated_at          DateTime?             @db.Timestamp(6)
  published_at        DateTime?             @db.Timestamp(6)
  created_by_id       Int?
  updated_by_id       Int?
  locale              String?               @db.VarChar(255)
  createdBy           admin_users?          @relation("files_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "files_created_by_id_fk")
  updatedBy           admin_users?          @relation("files_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "files_updated_by_id_fk")
  files_folder_lnk    files_folder_lnk[]
  files_related_mph   files_related_mph[]

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([created_at], map: "upload_files_created_at_index")
  @@index([ext], map: "upload_files_ext_index")
  @@index([folder_path], map: "upload_files_folder_path_index")
  @@index([name], map: "upload_files_name_index")
  @@index([size], map: "upload_files_size_index")
  @@index([updated_at], map: "upload_files_updated_at_index")
  @@index([document_id, locale, published_at], map: "files_documents_idx")
}

model files_folder_lnk {
  id             Int             @id @default(autoincrement())
  file_id        Int?
  folder_id      Int?
  file_ord       Float?
  files          files?          @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "files_folder_lnk_fk")
  upload_folders upload_folders? @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "files_folder_lnk_ifk")

  @@unique([file_id, folder_id], map: "files_folder_lnk_uq")
  @@index([file_id])
  @@index([folder_id])
  @@index([file_ord], map: "files_folder_lnk_oifk")
}

model files_related_mph {
  id           Int     @id @default(autoincrement())
  file_id      Int?
  related_id   Int?
  related_type String? @db.VarChar(255)
  field        String? @db.VarChar(255)
  order        Float?
  files        files?  @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "files_related_mph_fk")

  @@index([file_id])
  @@index([related_id], map: "files_related_mph_idix")
  @@index([order], map: "files_related_mph_oidx")
}

model homepages {
  id             Int          @id @default(autoincrement())
  document_id    String?      @db.VarChar(255)
  logo           String?      @db.VarChar(255)
  home_title     String?      @db.VarChar(255)
  subtitle       String?      @db.VarChar(255)
  created_at     DateTime?    @db.Timestamp(6)
  updated_at     DateTime?    @db.Timestamp(6)
  published_at   DateTime?    @db.Timestamp(6)
  created_by_id  Int?
  updated_by_id  Int?
  locale         String?      @db.VarChar(255)
  createdBy      admin_users? @relation("homepages_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "homepages_created_by_id_fk")
  updatedBy      admin_users? @relation("homepages_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "homepages_updated_by_id_fk")

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "homepages_documents_idx")
}

model i18n_locale {
  id            Int          @id @default(autoincrement())
  document_id   String?      @db.VarChar(255)
  name          String?      @db.VarChar(255)
  code          String?      @db.VarChar(255)
  created_at    DateTime?    @db.Timestamp(6)
  updated_at    DateTime?    @db.Timestamp(6)
  published_at  DateTime?    @db.Timestamp(6)
  created_by_id Int?
  updated_by_id Int?
  locale        String?      @db.VarChar(255)
  createdBy     admin_users? @relation("i18n_locales_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "i18n_locale_created_by_id_fk")
  updatedBy     admin_users? @relation("i18n_locales_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "i18n_locale_updated_by_id_fk")

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "i18n_locale_documents_idx")
}

model machine_makes {
  id                                 Int                                @id @default(autoincrement())
  document_id                        String?                            @db.VarChar(255)
  name                               String?                            @db.VarChar(255)
  created_at                         DateTime?                          @db.Timestamp(6)
  updated_at                         DateTime?                          @db.Timestamp(6)
  published_at                       DateTime?                          @db.Timestamp(6)
  created_by_id                      Int?
  updated_by_id                      Int?
  locale                             String?                            @db.VarChar(255)
  createdBy                          admin_users?                       @relation("machine_makes_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "machine_makes_created_by_id_fk")
  updatedBy                          admin_users?                       @relation("machine_makes_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "machine_makes_updated_by_id_fk")
  machine_makes_machine_model_lnk    machine_makes_machine_model_lnk[]
  machine_makes_machine_models_lnk   machine_makes_machine_models_lnk[]

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "machine_makes_documents_idx")
}

model machine_makes_machine_model_lnk {
  id               Int            @id @default(autoincrement())
  machine_make_id  Int?
  machine_model_id Int?
  machine_makes    machine_makes? @relation(fields: [machine_make_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "machine_makes_machine_model_lnk_fk")
  machine_models   machine_models?@relation(fields: [machine_model_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "machine_makes_machine_model_lnk_ifk")

  @@unique([machine_make_id, machine_model_id], map: "machine_makes_machine_model_lnk_uq")
  @@index([machine_make_id])
  @@index([machine_model_id])
}

model machine_makes_machine_models_lnk {
  id                Int            @id @default(autoincrement())
  machine_make_id   Int?
  machine_model_id  Int?
  machine_model_ord Float?
  machine_makes     machine_makes? @relation(fields: [machine_make_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "machine_makes_machine_models_lnk_fk")
  machine_models    machine_models?@relation(fields: [machine_model_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "machine_makes_machine_models_lnk_ifk")

  @@unique([machine_make_id, machine_model_id], map: "machine_makes_machine_models_lnk_uq")
  @@index([machine_make_id])
  @@index([machine_model_id])
  @@index([machine_model_ord], map: "machine_makes_machine_models_lnk_ofk")
}

model machine_models {
  id                                  Int                                   @id @default(autoincrement())
  document_id                         String?                               @db.VarChar(255)
  name                                String?                               @db.VarChar(255)
  created_at                          DateTime?                             @db.Timestamp(6)
  updated_at                          DateTime?                             @db.Timestamp(6)
  published_at                        DateTime?                             @db.Timestamp(6)
  created_by_id                       Int?
  updated_by_id                       Int?
  locale                              String?                               @db.VarChar(255)
  machine_makes_machine_model_lnk     machine_makes_machine_model_lnk[]
  machine_makes_machine_models_lnk    machine_makes_machine_models_lnk[]
  createdBy                           admin_users?                          @relation("machine_models_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "machine_models_created_by_id_fk")
  updatedBy                           admin_users?                          @relation("machine_models_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "machine_models_updated_by_id_fk")
  machine_models_compatible_parts_lnk machine_models_compatible_parts_lnk[]

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "machine_models_documents_idx")
}

model machine_models_compatible_parts_lnk {
  id                Int             @id @default(autoincrement())
  machine_model_id  Int?
  product_id        Int?
  product_ord       Float?
  machine_model_ord Float?
  machine_models    machine_models? @relation(fields: [machine_model_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "machine_models_compatible_parts_lnk_fk")
  products          products?       @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "machine_models_compatible_parts_lnk_ifk")

  @@unique([machine_model_id, product_id], map: "machine_models_compatible_parts_lnk_uq")
  @@index([machine_model_id])
  @@index([product_id])
  @@index([product_ord], map: "machine_models_compatible_parts_lnk_ofk")
  @@index([machine_model_ord], map: "machine_models_compatible_parts_lnk_oifk")
}

model products {
  id                                  Int                                   @id @default(autoincrement())
  document_id                         String?                               @db.VarChar(255)
  name                                String?                               @db.VarChar(255)
  slug                                String?                               @unique @db.VarChar(255)
  sku                                 String?                               @db.VarChar(255)
  description                         String?                               @db.VarChar(255)
  stock_status                        String?                               @db.VarChar(255)
  specs                               Json?
  created_at                          DateTime?                             @db.Timestamp(6)
  updated_at                          DateTime?                             @db.Timestamp(6)
  published_at                        DateTime?                             @db.Timestamp(6)
  created_by_id                       Int?
  updated_by_id                       Int?
  locale                              String?                               @db.VarChar(255)
  brand                               String?                               @db.VarChar(255)
  price       Decimal   @db.Decimal(10, 2) @default(0)
  cart_items                          cart_items[]
  categories_products_lnk             categories_products_lnk[]
  machine_models_compatible_parts_lnk machine_models_compatible_parts_lnk[]
  createdBy                           admin_users?                          @relation("products_created_by", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "products_created_by_id_fk")
  updatedBy                           admin_users?                          @relation("products_updated_by", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "products_updated_by_id_fk")
  quote_items                         quote_items[]

  @@index([created_by_id])
  @@index([updated_by_id])
  @@index([document_id, locale, published_at], map: "products_documents_idx")
}

model quote_items {
  id               Int            @id @default(autoincrement())
  quote_request_id Int
  product_id       Int
  quantity         Int            @default(1)
  unit_price       Decimal        @db.Decimal(10, 2)
  products         products       @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "quote_items_product_fkey")
  quote_requests   quote_requests @relation(fields: [quote_request_id], references: [id], onDelete: Cascade, map: "quote_items_request_fkey")

